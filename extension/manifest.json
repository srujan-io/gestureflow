{
  "manifest_version": 3,
  "name": "ContextSwitch",
  "minimum_chrome_version": "120",
  "version": "1.3.0",
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "description": "Detects website context and executes validated browser actions.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["http://127.0.0.1:8001/*"],
  "optional_host_permissions": ["https://kicanvas.org/*", "https://*.kicanvas.org/*", "https://*.youtube.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "ui/extension.html", "default_title": "ContextSwitch", "default_icon":{"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"}}
}
