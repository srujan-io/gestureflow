# Backend only; never copy keys to frontend or extension.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Camera remains paused until enabled in the UI unless explicitly set to 1.
BEYOND_TOUCH_CAMERA=0
BEYOND_TOUCH_CAMERA_INDEX=0
# Optional microphone device index; blank uses the system default.
BEYOND_TOUCH_MIC_INDEX=
# Optional supplied semantic pipeline; requires fastembed and a local model download.
# Its fixture catalog may not match your schematic. Off by default.
BEYOND_TOUCH_SEMANTIC=0
# Optional discovered Pico firmware V1. Choose a port from /hardware/ports or UI.
CONTEXTSWITCH_IMU_PORT=
CONTEXTSWITCH_IMU_BAUD=115200
CONTEXTSWITCH_IMU_DECODER=pico_imu:Decoder
# Signed permutation of the sensor pitch/yaw/roll axes; verify your mounting.
CONTEXTSWITCH_IMU_AXES=pitch,yaw,roll
